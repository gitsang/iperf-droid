<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <TextView
        android:id="@+id/tvConfigTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="28dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/title_config"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/title_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Every action on this screen is an icon, so the list keeps its width on a phone. -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginEnd="@dimen/screen_margin_end"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/action_back"
        android:focusable="true"
        android:padding="@dimen/icon_button_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="@id/tvConfigTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvConfigTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerConfig"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/grid_padding"
        android:paddingEnd="@dimen/grid_padding"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnAdd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvConfigTitle" />

    <ImageView
        android:id="@+id/btnAdd"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/action_add"
        android:focusable="true"
        android:padding="@dimen/icon_button_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/btnSelfCheck"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/action_selfcheck"
        android:focusable="true"
        android:padding="@dimen/icon_button_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnAdd" />

</androidx.constraintlayout.widget.ConstraintLayout>
