<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Defaults: phones. Tighter margins, because 48dp of leading space wastes a fifth of the
         width in portrait, and a smaller title so it does not wrap next to the Settings button. -->
    <dimen name="screen_margin">20dp</dimen>
    <dimen name="screen_margin_end">16dp</dimen>
    <dimen name="grid_padding">16dp</dimen>
    <dimen name="title_size">24sp</dimen>

    <!-- Icon buttons. 48dp is still the minimum comfortable touch target; the padding controls how
         large the glyph itself appears inside it. -->
    <dimen name="icon_button_size">48dp</dimen>
    <dimen name="icon_button_padding">13dp</dimen>

    <!-- List cards. -->
    <dimen name="card_padding">14dp</dimen>
    <dimen name="card_outer_margin">4dp</dimen>
</resources>
